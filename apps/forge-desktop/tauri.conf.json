{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDNA Forge",
  "version": "0.1.0",
  "identifier": "io.rdnaforge.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RDNA Forge",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#141517"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
